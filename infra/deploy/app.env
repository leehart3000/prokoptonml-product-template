# Deploy settings for the product's API on Google Cloud Run. Nothing here is
# secret: the API key is in Secret Manager and CI signs in with Workload
# Identity Federation. Read by .github/workflows/deploy.yml; set them up as
# in docs/new-product.md (each REPLACE-… value is yours to fill in).
PROJECT_ID=REPLACE-project-id
REGION=europe-west2
WIF_PROVIDER=projects/REPLACE-project-number/locations/global/workloadIdentityPools/github/providers/REPLACE-provider
DEPLOYER_SA=github-deployer@REPLACE-project-id.iam.gserviceaccount.com
IMAGE=europe-west2-docker.pkg.dev/REPLACE-project-id/images/REPLACE-name-api
SERVICE=REPLACE-name-api
RUNTIME_SA=REPLACE-name-api@REPLACE-project-id.iam.gserviceaccount.com
SECRET=REPLACE-name-api-key
# The serving bundle to build into the image (one dated folder per bundle)
BUNDLE=gs://REPLACE-name-bundles/REPLACE-date
# Cloud Run limits: scale to zero, at most 2 instances, so costs stay small
CPU=1
MEMORY=2Gi
CONCURRENCY=4
MAX_INSTANCES=2
TIMEOUT=120
